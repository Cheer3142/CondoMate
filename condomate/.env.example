# Copy to .env.local (or .env) and adjust if your API runs somewhere else.
# For local development only, use the Express API:
VITE_API_URL=http://localhost:4000/api

# Vercel: add these under Project Settings → Environment Variables.
# DATABASE_URL is injected automatically when you connect the Neon integration.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
SESSION_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Backend credentials for the juristic-person admin portal. Set these in server/.env
# before deploying; the values below are the local-demo defaults.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=condomate-admin
